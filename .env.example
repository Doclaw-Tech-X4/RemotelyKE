# Supabase Configuration
# Replace with your Supabase Project URL and Public Anon Key from project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paystack Configuration
# Replace with your Paystack Public Key (test or live) e.g., pk_test_... or pk_live_...
VITE_PAYSTACK_PUBLIC_KEY=pk_test_sample_key_replace_with_yours

# Application Settings
VITE_APP_NAME="RemotelyKE"
VITE_REGISTRATION_FEE=300
VITE_TRAINING_FEE=500
VITE_CURRENCY=KES
